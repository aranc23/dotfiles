{
"mcpServers": {
      "gitlab-uiowa": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@zereight/mcp-gitlab"
        ],
        "env": {
          "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
          "GITLAB_API_URL": "https://git.uiowa.edu/api/v4"
        }
      }
    }
}
