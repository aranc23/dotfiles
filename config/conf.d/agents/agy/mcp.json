{
  "mcpServers": {
    "gitea-mcp": {
      "command": "gitea-mcp",
      "env": {
        "GITEA_URL": "{{ exec(command='mise env --json | jq -r .GITEA_HOST') | trim }}",
        "GITEA_TOKEN": "{{ env.GITEA_ACCESS_TOKEN }}",
        "GITEA_ACCESS_TOKEN": "{{ env.GITEA_ACCESS_TOKEN }}"
      }
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ env.GITHUB_PAT }}"
      },
      "disabled": false
    }
  }
}
