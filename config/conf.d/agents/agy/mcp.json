{
  "mcpServers": {
    "gitea-mcp": {
      "command": "gitea-mcp",
      "env": {
        "GITEA_URL": "{{ get_env(name="GITEA_HOST", default="missing") }}"
        "GITEA_TOKEN": "{{ get_env(name="GITEA_ACCESS_TOKEN", default="missing") }}",
        "GITEA_ACCESS_TOKEN": "{{ get_env(name="GITEA_ACCESS_TOKEN", default="missing") }}"
      }
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ get_env(name="GITHUB_PAT", default="missing") }}"
      },
      "disabled": false
    }
  }
}
