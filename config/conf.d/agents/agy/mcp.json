{
  "mcpServers": {
    "gitea-mcp": {
      "command": "gitea-mcp",
      "env": {
        "GITEA_URL": "{env:GITEA_HOST}",
        "GITEA_TOKEN": "{env:GITEA_ACCESS_TOKEN}",
        "GITEA_ACCESS_TOKEN": "{env:GITEA_ACCESS_TOKEN}"
      }
    },
    "github": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/share/mise/shims/mcp-remote\" https://api.githubcopilot.com/mcp/ --header \"Authorization: Bearer ${GITHUB_PAT}\""
      ]
      "disabled": false
    }
  }
}
