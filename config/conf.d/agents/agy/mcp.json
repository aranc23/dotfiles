{
  "mcpServers": {
    "gitea-mcp": {
      "command": "gitea-mcp",
      "env": {
        "GITEA_URL": "{{ exec(command='sops decrypt --output-type json ~/sops/git-tokens.env | jq -r .GITEA_HOST') | trim }}",
        "GITEA_TOKEN": "{{ exec(command='sops decrypt --output-type json ~/sops/git-tokens.env | jq -r .GITEA_ACCESS_TOKEN') | trim  }}",
        "GITEA_ACCESS_TOKEN": "{{ exec(command='sops decrypt --output-type json ~/sops/git-tokens.env | jq -r .GITEA_ACCESS_TOKEN') | trim  }}"
      }
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ env.GITHUB_PAT }}"
      },
      "disabled": false
    }
  }
}
