{
  "mcpServers": {
    "gitea-mcp": {
      "command": "gitea-mcp",
      "env": {
        "GITEA_URL": "{{ exec(command='mise env --json | jq -r .GITEA_HOST') | trim }}",
        "GITEA_TOKEN": "{{ exec(command='mise env --json | jq -r .GITEA_ACCESS_TOKEN') | trim }}",
        "GITEA_ACCESS_TOKEN": "{{ get_env(name="GITEA_ACCESS_TOKEN", default="missing") }}"
      }
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ exec(command='mise env --json | jq -r .GITHUB_PAT') | trim }}"
      },
      "disabled": false
    }
  }
}
