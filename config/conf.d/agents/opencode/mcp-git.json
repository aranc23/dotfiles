{
  "mcp": {
    "gitea": {
      "type": "local",
      "command": [
        "gitea-mcp"
      ],
      "environment": {
        "GITEA_URL": "{env:GITEA_HOST}",
        "GITEA_TOKEN": "{env:GITEA_ACCESS_TOKEN}",
        "GITEA_ACCESS_TOKEN": "{env:GITEA_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "GitLab": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote@latest",
        "https://git.uiowa.edu/api/v4/mcp"
      ],
      "environment": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  }
}
