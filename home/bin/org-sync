#!/usr/bin/env bash
set -euo pipefail

cd "${ORG_DIR:-$HOME/org}"

# Abort if a rebase or merge conflict is already in progress
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ]; then
  exit 0
fi

# Fetch remote changes first so incoming edits don't get stuck behind local state
git fetch origin master --quiet

# Stage and commit local changes if any exist
git add -A
if ! git diff-index --quiet HEAD --; then
  git commit -m "org sync: $(hostname -s) $(date '+%Y-%m-%d %H:%M')" --quiet
fi

# Rebase local commits onto origin/master and push if ahead
if [ "$(git rev-list HEAD..origin/master --count)" -gt 0 ]; then
  git pull --rebase --autostash origin master --quiet
fi

if [ "$(git rev-list origin/master..HEAD --count)" -gt 0 ]; then
  git push origin master --quiet
fi
