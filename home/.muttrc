# distributed by puppet, do not modify locally

# the following control caching
# they are not available in mutt 1.4 and will cause errors
set header_cache=~/.mutt_header_cache
set message_cachedir=~/.mutt_message_cache
set header_cache_compress="yes"
set message_cache_clean="yes"
source ~/.muttrc.mailboxes

set envelope_from=yes
set mbox_type=Maildir

#set spoolfile="imaps://mail.divms.uiowa.edu/"
set spoolfile="/mnt/nfs/clasnetappvm/maildirs/accx/Inbox/"
set folder="/mnt/nfs/clasnetappvm/maildirs/accx/Inbox/"

set move="no" 
set mask="!^\\.[^.]"

set record="+.Sent"
set postponed="+.Drafts"
set tilde="yes"
#alternates = "acox@ia\.primustel\.com|arancox@gmail\.com|arancox@mchsi\.com|spin667@mchsi\.com|acox@voip\.primustel\.com|acox@cv\.telegroup\.com"
#lists = "eng@(ia\.primustel|cv\.telegroup)\.com"

set imap_check_subscribed = yes
set imap_list_subscribed = no

my_hdr From: Aran Cox <aran-cox@uiowa.edu>
set imap_user = accx
set from = aran-cox@uiowa.edu
set realname = "Aran Cox"

folder-hook . set sort=date-received

ignore *
unignore From To Cc Subject Date Reply-To Organization X-Mailer User-Agent
hdr_order From: Date: To: Cc: Subject:

unset reply_self

set implicit_autoview="yes"
#set editor="emacs -nw"
set editor="emacsclient -nw"
auto_view text/html

alternative_order text/plain text/html

#mailboxes imaps://mail.divms.uiowa.edu/INBOX

bind generic <end> last-entry

