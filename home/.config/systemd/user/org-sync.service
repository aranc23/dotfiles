[Unit]
Description=Watch and sync Org-mode repository
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/org
ExecStart=%h/.local/share/mise/shims/watchexec \
  --debounce 15s \
  --ignore ".git/**" \
  --ignore ".#*" \
  --ignore "#*#" \
  -- %h/bin/org-sync
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
